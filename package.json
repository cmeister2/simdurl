{
  "name": "simdurl-release",
  "version": "0.0.0-development",
  "private": true,
  "description": "Release tooling for the simdurl C library",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cmeister2/simdurl.git"
  },
  "engines": {
    "node": ">=24.10.0"
  },
  "scripts": {
    "test:release": "node --test scripts/test-release.mjs scripts/test-release-preview.mjs scripts/test-release-publish.mjs",
    "release": "semantic-release",
    "release:dry-run": "node scripts/preview-release.mjs",
    "release:prepare": "node scripts/prepare-release.mjs"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/release-notes-generator": "14.1.1",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "semantic-release": "25.0.9"
  }
}
